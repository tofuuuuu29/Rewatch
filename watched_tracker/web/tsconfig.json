{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"strict": true,
		"jsx": "preserve",
		"isolatedModules": true,
		"skipLibCheck": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"types": ["vite/client"],
		"baseUrl": ".",
		"paths": {"@/*": ["src/*"]}
	},
	"include": ["src/**/*.ts", "src/**/*.vue"]
}
